---
/** Three real project screens, staggered — used where a "studio" image would go. */
import ScreenFrame from './ScreenFrame.astro';
import { getWork } from '@/data/work';

interface Props { slugs: [string, string, string]; caption?: string }
const { slugs, caption } = Astro.props;
const items = slugs.map((s) => getWork(s)!).filter(Boolean);
---

<div class="wrap">
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-3 sm:gap-5">
    {items.map((item, i) => (
      <a
        href={`/work/${item.slug}`}
        class:list={['group block', i === 1 && 'sm:translate-y-12', i !== 1 && 'hidden sm:block']}
        data-media
        data-cursor="View"
        data-reveal
      >
        <div data-parallax={i === 1 ? '-6' : '6'}>
          <ScreenFrame item={item} sizes="(min-width: 640px) 33vw, 100vw" />
        </div>
        <p class="label mt-3">{item.client}</p>
      </a>
    ))}
  </div>
  {caption && <p class="label mt-16 text-center sm:mt-20" data-reveal>{caption}</p>}
</div>
