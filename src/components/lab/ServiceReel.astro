---
/**
 * Services "kinetic reel" — modelled on a motion-typography reel:
 * one huge word at a time over a full-bleed scene, hard cuts between scenes,
 * alternating light and dark. Here every cut is driven by scroll.
 */
import { Image } from 'astro:assets';
import illusBuild from '@/assets/images/illus-build.jpg';
import illusGrow from '@/assets/images/illus-grow.jpg';
import illusRun from '@/assets/images/illus-run.jpg';
import illusMed from '@/assets/images/illus-medpulse.jpg';
import illusUn from '@/assets/images/illus-unstiched.jpg';
import illusBilim from '@/assets/images/illus-bilim.jpg';
import bmUs1 from '@/assets/work/baemeds-usa-1.jpg';
import bmUs2 from '@/assets/work/baemeds-usa-2.jpg';
import bmUs3 from '@/assets/work/baemeds-usa-3.jpg';
import qalb1 from '@/assets/work/the-qalb-1.jpg';
import qalb2 from '@/assets/work/the-qalb-2.jpg';
import qalb3 from '@/assets/work/the-qalb-3.jpg';
import thc1 from '@/assets/work/talent-hunters-consulting-1.jpg';
import thc2 from '@/assets/work/talent-hunters-consulting-2.jpg';
import conav1 from '@/assets/work/conavlytics-1.jpg';
import devit1 from '@/assets/work/devit-1.jpg';
import erus1 from '@/assets/work/erus-academy-1.jpg';
import erus2 from '@/assets/work/erus-academy-2.jpg';
import erus3 from '@/assets/work/erus-academy-3.jpg';
import med1 from '@/assets/work/meduscore-1.jpg';
import auvia1 from '@/assets/work/auvia-1.jpg';
import bmIn1 from '@/assets/work/baemeds-india-1.jpg';

// floating cards for the opening scene: [image, x%, y%, rotate, size(vw)]
const cloud: [typeof bmUs1, number, number, number, number][] = [
  [qalb2, 6, 12, -14, 9], [erus1, 22, 4, 10, 7], [illusGrow, 70, 8, 8, 10], [thc1, 86, 22, -10, 8],
  [auvia1, 4, 58, 12, 8], [bmUs1, 16, 78, -6, 10], [illusUn, 34, 68, 14, 7], [med1, 58, 74, -12, 9],
  [illusRun, 78, 64, 6, 11], [devit1, 90, 82, -8, 6], [conav1, 46, 6, -4, 6], [illusBuild, 62, 40, 16, 6],
  [qalb3, 28, 30, -18, 6], [bmIn1, 84, 44, 12, 6],
];
const wall = [bmUs1, erus1, qalb1, thc1, auvia1, illusMed, conav1, med1, illusBuild, bmIn1, devit1, illusBilim];

type Scene = { word: string; theme: 'light' | 'dark' | 'amber' | 'red' | 'plum' | 'grad'; visual?: string; href?: string; tag?: string };
const scenes: Scene[] = [
  { word: 'everything', theme: 'light', visual: 'cloud' },
  { word: 'your business', theme: 'dark' },
  { word: 'needs', theme: 'light' },
  { word: 'online.', theme: 'grad' },
  { word: 'Websites', href: '/services/web-development', tag: 'Websites & web apps', theme: 'plum', visual: 'stack' },
  { word: 'Stores', href: '/services/ecommerce', tag: 'E-commerce', theme: 'amber', visual: 'shop' },
  { word: 'Apps', href: '/services/mobile-apps', tag: 'Mobile apps', theme: 'dark', visual: 'phones' },
  { word: 'SEO', href: '/services/seo', tag: 'Search engine optimisation', theme: 'light', visual: 'search' },
  { word: 'Ads', href: '/services/paid-ads-social', tag: 'Paid ads & social', theme: 'dark', visual: 'quads' },
  { word: 'Care', href: '/services/maintenance', tag: 'Maintenance & growth', theme: 'red', visual: 'pulse' },
  { word: 'ServiceNow', href: '/services/servicenow', tag: 'ServiceNow', theme: 'light', visual: 'flow' },
  { word: 'Just', theme: 'light' },
  { word: 'tell', theme: 'dark' },
  { word: 'us.', theme: 'grad', visual: 'wall' },
];
---

<section class="reel" style={`--n:${scenes.length}`} data-reel aria-label="What we do, in one scroll">
  <div class="reel-pin">
    {scenes.map((s, i) => (
      <div class={`reel-scene t-${s.theme}`} data-scene={i} aria-hidden={i === 0 ? undefined : 'true'}>
        {s.visual === 'cloud' && (
          <div class="v-cloud">
            {cloud.map(([img, x, y, r, w], k) => (
              <div class="cloud-card" style={`left:${x}%;top:${y}%;--w:${w}vw;--r:${r}deg;--d:${(k % 5) * -1.3}s`}>
                <Image src={img} alt="" width={420} class="size-full object-cover" loading="eager" />
              </div>
            ))}
          </div>
        )}

        {s.visual === 'stack' && (
          <div class="v-stack">
            {[bmUs2, erus2, thc2].map((img, k) => (
              <div class="stack-layer" style={`--k:${k}`}>
                <Image src={img} alt="" widths={[600, 1000]} sizes="46vw" class="size-full object-cover object-top" loading="eager" />
              </div>
            ))}
          </div>
        )}

        {s.visual === 'shop' && (
          <div class="v-shop">
            {[qalb1, bmUs3, qalb3, bmUs1, qalb2, bmIn1].map((img, k) => (
              <div class="shop-tile" style={`--k:${k}`}>
                <Image src={img} alt="" width={520} class="size-full object-cover object-top" loading="eager" />
                <span class="shop-add">+ Add</span>
              </div>
            ))}
          </div>
        )}

        {s.visual === 'phones' && (
          <div class="v-phones">
            {[erus1, erus2, erus3].map((img, k) => (
              <div class="phone" style={`--k:${k}`}>
                <Image src={img} alt="" width={520} class="size-full object-cover" loading="eager" />
              </div>
            ))}
          </div>
        )}

        {s.visual === 'search' && (
          <div class="v-search">
            <div class="search-bar"><span class="search-ico">⌕</span><span class="search-type">best digital agency near me</span></div>
            <div class="search-res res-1"><span>#1</span> zemprolabs.com</div>
            <div class="search-res res-2"></div>
            <div class="search-res res-3"></div>
          </div>
        )}

        {s.visual === 'quads' && (
          <div class="v-quads">
            <div class="quad q1"><span class="q-card">CTR ↑</span></div>
            <div class="quad q2"><span class="q-card">Leads 128</span></div>
            <div class="quad q3"><span class="q-card">♥ 1,602</span></div>
            <div class="quad q4"><span class="q-card">ROAS 4.2×</span></div>
          </div>
        )}

        {s.visual === 'pulse' && (
          <svg class="v-pulse" viewBox="0 0 1200 300" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 160 H330 L370 160 L400 60 L440 260 L480 110 L510 160 H760 L800 160 L830 80 L870 240 L905 130 L935 160 H1200" />
          </svg>
        )}

        {s.visual === 'flow' && (
          <div class="v-flow">
            {['Incident', 'Triage', 'Risk check', 'Released ✓'].map((t, k) => <span class="flow-node" style={`--k:${k}`}>{t}</span>)}
          </div>
        )}

        {s.visual === 'wall' && (
          <div class="v-wall">
            <div class="wall-grid">
              {[...wall, ...wall].map((img, k) => (
                <div class="wall-tile"><Image src={img} alt="" width={420} class="size-full object-cover object-top" loading="eager" /></div>
              ))}
            </div>
          </div>
        )}

        <p class="reel-word">{s.word}</p>
        {s.href && (
          <a href={s.href} class="reel-tag" tabindex={i === 0 ? undefined : -1}>
            <span class="lab-mono">{s.tag}</span><span aria-hidden="true">→</span>
          </a>
        )}
        {i === scenes.length - 1 && (
          <div class="reel-cta">
            <a href="/contact" class="lab-btn">Start a project <span aria-hidden="true">→</span></a>
            <span class="lab-mono">zemprolabs.com</span>
          </div>
        )}
      </div>
    ))}
    <div class="reel-meta lab-mono" aria-hidden="true"><span data-reel-count>01</span> / {String(scenes.length).padStart(2, '0')}</div>
    <div class="reel-hint lab-mono" aria-hidden="true">Scroll ↓</div>
  </div>
</section>

<style>
  .reel { position: relative; height: calc(var(--n) * 55vh + 100vh); background: #150e16; }
  @media (max-width: 899px) { .reel { height: calc(var(--n) * 28vh + 100vh); } }
  .reel-pin { position: sticky; top: 0; height: 100vh; overflow: hidden; }
  :global(html:not(.motion)) .reel { height: auto; }
  :global(html:not(.motion)) .reel-pin { position: relative; height: auto; }
  :global(html:not(.motion)) .reel-scene { position: relative; height: 70vh; opacity: 1; visibility: visible; }

  .reel-scene { position: absolute; inset: 0; display: grid; place-items: center; overflow: hidden; visibility: hidden; }
  .reel-scene.is-on { visibility: visible; }
  .t-light { background: #fbf4ea; color: #1a1218; }
  .t-dark { background: #150e16; color: #fbf4ea; }
  .t-amber { background: #ffb33f; color: #1a1218; }
  .t-red { background: #f2464b; color: #fff; }
  .t-plum { background: #2a1b30; color: #fff; }
  .t-grad { background: linear-gradient(120deg, #ffb33f, #ff7a2f 30%, #f2464b 55%, #b8326e 80%, #5b2a86); color: #fff; }

  .reel-word {
    position: relative;
    z-index: 5;
    margin: 0;
    font-family: 'Inter Tight', 'Inter', sans-serif;
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.9;
    font-size: clamp(3.6rem, 11vw, 11.5rem);
    text-align: center;
    padding: 0 4vw;
    text-shadow: 0 6px 40px rgba(0, 0, 0, 0.12);
  }
  .t-plum .reel-word, .t-dark .reel-word { text-shadow: 0 10px 50px rgba(0, 0, 0, 0.5); }
  .reel-meta { position: absolute; left: 2.5rem; bottom: 1.6rem; z-index: 6; color: rgba(248, 239, 228, 0.6); mix-blend-mode: difference; }
  .reel-hint { position: absolute; right: 2.5rem; bottom: 1.6rem; z-index: 6; color: rgba(248, 239, 228, 0.6); mix-blend-mode: difference; }
  .reel-tag { position: absolute; z-index: 6; left: 50%; bottom: 13%; transform: translateX(-50%); display: inline-flex; align-items: center; gap: 0.7rem; border-radius: 999px; padding: 0.7rem 1.2rem; background: rgba(255, 255, 255, 0.9); color: #1a1218; box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.45); backdrop-filter: blur(10px); transition: background-color 0.3s, color 0.3s; white-space: nowrap; }
  .reel-tag:hover { background: #1a1218; color: #fff; }
  .reel-cta { position: absolute; bottom: 14%; left: 0; right: 0; z-index: 6; display: flex; flex-direction: column; align-items: center; gap: 1rem; color: #fff; }

  /* ---------- scene: floating cards cloud ---------- */
  .v-cloud { position: absolute; inset: 0; }
  .cloud-card { position: absolute; width: var(--w); aspect-ratio: 3 / 4; border-radius: 10px; overflow: hidden; box-shadow: 0 20px 40px -20px rgba(26, 18, 24, 0.5); transform: rotate(var(--r)); animation: cloud 9s ease-in-out infinite alternate; animation-delay: var(--d); }
  @keyframes cloud { from { transform: rotate(var(--r)) translate3d(0, 0, 0); } to { transform: rotate(calc(var(--r) * -0.6)) translate3d(14px, -26px, 0); } }

  /* ---------- scene: stacked 3D layers ---------- */
  .v-stack { position: absolute; inset: 0; display: grid; place-items: center; perspective: 1400px; }
  .stack-layer { position: absolute; width: min(46vw, 760px); aspect-ratio: 16 / 9; border-radius: 16px; overflow: hidden; box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.6); transform: rotateX(56deg) rotateZ(-32deg) translateZ(calc(var(--k) * 90px - 90px)); animation: stack 4s ease-in-out infinite alternate; animation-delay: calc(var(--k) * -0.4s); }
  @keyframes stack { to { transform: rotateX(52deg) rotateZ(-28deg) translateZ(calc(var(--k) * 120px - 110px)); } }

  /* ---------- scene: shop grid ---------- */
  .v-shop { position: absolute; inset: -6%; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2vw; padding: 4vw; transform: rotate(-8deg) scale(1.1); }
  .shop-tile { position: relative; border-radius: 16px; overflow: hidden; background: #fff; box-shadow: 0 30px 50px -30px rgba(26, 18, 24, 0.45); animation: shop 5s ease-in-out infinite alternate; animation-delay: calc(var(--k) * -0.7s); }
  .shop-add { position: absolute; right: 10px; bottom: 10px; border-radius: 999px; background: #1a1218; color: #fff; padding: 0.3rem 0.7rem; font: 600 0.75rem 'Inter Tight', sans-serif; }
  @keyframes shop { to { transform: translateY(-14px); } }

  /* ---------- scene: phones ---------- */
  .v-phones { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; gap: 3vw; }
  .phone { width: min(17vw, 260px); aspect-ratio: 9 / 19; border-radius: 34px; overflow: hidden; border: 8px solid #2a1b30; box-shadow: 0 50px 80px -30px rgba(0, 0, 0, 0.7); transform: translateY(calc((var(--k) - 1) * -8%)) rotate(calc((var(--k) - 1) * 8deg)); animation: phone 4.5s ease-in-out infinite alternate; animation-delay: calc(var(--k) * -0.8s); }
  @keyframes phone { to { translate: 0 -18px; } }

  /* ---------- scene: search ---------- */
  .v-search { position: absolute; top: 14%; left: 50%; width: min(70vw, 900px); transform: translateX(-50%); display: grid; gap: 14px; }
  .search-bar { display: flex; align-items: center; gap: 14px; border-radius: 999px; background: #fff; padding: 1rem 1.4rem; font: 500 clamp(1rem, 1.6vw, 1.4rem) 'Inter', sans-serif; color: #1a1218; box-shadow: 0 20px 40px -24px rgba(26, 18, 24, 0.35); }
  .search-ico { font-size: 1.4em; color: #f2464b; }
  .search-type { overflow: hidden; white-space: nowrap; border-right: 2px solid #1a1218; animation: typing 3.2s steps(28) infinite alternate; width: 28ch; }
  @keyframes typing { from { width: 0; } to { width: 28ch; } }
  .search-res { height: 3.4rem; border-radius: 16px; background: #f4eadd; }
  .res-1 { display: flex; align-items: center; gap: 12px; padding: 0 1.2rem; background: linear-gradient(100deg, #ffb33f, #f2464b); color: #fff; font: 600 1.05rem 'Inter Tight', sans-serif; order: 3; animation: climb 3.2s ease-in-out infinite alternate; }
  .res-1 span { border-radius: 999px; background: #1a1218; padding: 0.15rem 0.6rem; font-size: 0.8rem; }
  @keyframes climb { 0%, 40% { order: 3; transform: translateY(0); } 60%, 100% { transform: translateY(-136px); } }
  .v-search { margin-top: 0; }
  .t-light .v-search ~ .reel-word { margin-top: 30vh; }

  /* ---------- scene: colour quadrants ---------- */
  .v-quads { position: absolute; inset: 0; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; }
  .quad { position: relative; display: grid; place-items: center; }
  .q1 { background: #ffb33f; } .q2 { background: #b8326e; } .q3 { background: #f2464b; } .q4 { background: #5b2a86; }
  .q-card { border-radius: 14px; background: rgba(255, 255, 255, 0.92); color: #1a1218; padding: 0.7rem 1.1rem; font: 600 1.05rem 'Inter Tight', sans-serif; box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.4); animation: shop 3.5s ease-in-out infinite alternate; }
  .q2 .q-card, .q4 .q-card { animation-delay: -1.2s; }

  /* ---------- scene: pulse ---------- */
  .v-pulse { position: absolute; left: 0; right: 0; top: 50%; width: 100%; height: 34vh; transform: translateY(-50%); }
  .v-pulse path { fill: none; stroke: rgba(255, 255, 255, 0.55); stroke-width: 6; stroke-linejoin: round; stroke-dasharray: 1700; animation: pulse 2.6s linear infinite; }
  @keyframes pulse { from { stroke-dashoffset: 1700; } to { stroke-dashoffset: -1700; } }

  /* ---------- scene: ServiceNow flow ---------- */
  .v-flow { position: absolute; top: 18%; left: 50%; transform: translateX(-50%); display: flex; gap: 2.4vw; }
  .flow-node { border-radius: 14px; background: #fff; border: 1px solid rgba(26, 18, 24, 0.1); padding: 0.8rem 1.2rem; font: 600 1rem 'Inter Tight', sans-serif; color: #1a1218; animation: node 3.2s ease-in-out infinite; animation-delay: calc(var(--k) * 0.8s); }
  .flow-node:last-child { background: #1a1218; color: #ffb33f; }
  @keyframes node { 0%, 100% { box-shadow: none; transform: none; } 12% { box-shadow: 0 0 0 4px rgba(242, 70, 75, 0.35); transform: translateY(-6px); } 30% { box-shadow: none; transform: none; } }

  /* ---------- scene: final poster wall ---------- */
  .v-wall { position: absolute; inset: 0; perspective: 1600px; }
  .wall-grid { position: absolute; inset: -30%; display: grid; grid-template-columns: repeat(6, 1fr); gap: 1.4vw; transform: rotateX(28deg) rotateZ(-18deg); animation: wall 18s linear infinite; }
  .wall-tile { aspect-ratio: 4 / 3; border-radius: 12px; overflow: hidden; box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.6); opacity: 0.88; }
  @keyframes wall { to { transform: rotateX(28deg) rotateZ(-18deg) translateY(-25%); } }
  .v-shop::after, .v-wall::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(60% 45% at 50% 50%, rgba(21, 14, 22, 0.78), rgba(21, 14, 22, 0.25) 70%, transparent); }
  .v-shop { isolation: isolate; }
  .v-shop::after { inset: 6%; transform: rotate(8deg) scale(0.9); }
  .t-amber:has(.v-shop) .reel-word { color: #fff; text-shadow: 0 10px 50px rgba(0, 0, 0, 0.6); }
  .t-grad .reel-word { text-shadow: 0 10px 60px rgba(26, 18, 24, 0.45); }

  @media (max-width: 767px) {
    .phone { width: 26vw; border-width: 5px; border-radius: 20px; }
    .stack-layer { width: 80vw; }
    .v-flow { flex-wrap: wrap; justify-content: center; width: 90vw; gap: 8px; }
    .reel-meta, .reel-hint { left: 1.25rem; right: auto; }
    .reel-hint { display: none; }
    .cloud-card { width: calc(var(--w) * 2.4); margin-left: calc(var(--w) * -0.7); }
    .v-shop { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 22vh; inset: -4% -20%; }
    .wall-grid { grid-template-columns: repeat(3, 1fr); inset: -40% -60%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .reel *, .reel *::before { animation: none !important; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const reel = document.querySelector<HTMLElement>('[data-reel]');
  const motion = document.documentElement.classList.contains('motion');
  if (reel && motion) {
    const scenes = [...reel.querySelectorAll<HTMLElement>('[data-scene]')];
    const count = reel.querySelector<HTMLElement>('[data-reel-count]')!;
    const n = scenes.length;
    let current = -1;

    const cut = (i: number) => {
      if (i === current) return;
      const dir = i > current ? 1 : -1;
      current = i;
      scenes.forEach((s, k) => {
        s.classList.toggle('is-on', k === i);
        s.setAttribute('aria-hidden', String(k !== i));
        s.querySelectorAll('a').forEach((a) => (k === i ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
      });
      const s = scenes[i];
      const word = s.querySelector('.reel-word');
      // a quick "cut" punch: the word snaps in, the scene settles from a slight zoom
      gsap.fromTo(word, { scale: 0.86, opacity: 0, y: 30 * dir }, { scale: 1, opacity: 1, y: 0, duration: 0.45, ease: 'expo.out' });
      gsap.fromTo(s, { scale: 1.06 }, { scale: 1, duration: 0.7, ease: 'expo.out' });
      count.textContent = String(i + 1).padStart(2, '0');
    };
    cut(0);

    ScrollTrigger.create({
      trigger: reel,
      start: 'top top',
      end: 'bottom bottom',
      onUpdate: (self) => cut(Math.min(n - 1, Math.floor(self.progress * n * 0.9999))),
    });
  }
</script>
