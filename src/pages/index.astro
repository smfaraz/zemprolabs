---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import HomeServices from '@/components/lab/HomeServices.astro';
import HomeMarquee from '@/components/lab/HomeMarquee.astro';
import { work, getWork } from '@/data/work';
import { services } from '@/data/services';
import { site } from '@/data/site';

// Rows in the tilted dashboard (real projects)
const rowColors = ['#FF9A2E', '#FF6A2F', '#F2464B', '#C2366F', '#8A2F86', '#5B2A86'];
const boardRows = ['auvia', 'erus-academy', 'baemeds-usa', 'the-qalb', 'meduscore', 'talent-hunters-consulting'].map((s, i) => ({
  item: getWork(s)!,
  color: rowColors[i],
}));


// hero: the 3D laptop + phone show the real BaeMeds USA site
const heroCase = getWork('baemeds-usa')!;
const heroPillars = [
  { name: 'Build', line: 'Web · App · Ecommerce', icon: 'code', href: '/services/web-development' },
  { name: 'Grow', line: 'SEO · Ads · Conversion', icon: 'chart', href: '/services/seo' },
  { name: 'Maintain', line: 'Support · Scale · Optimize', icon: 'layers', href: '/services/maintenance' },
];
const heroSectors = [
  { name: 'Healthcare', icon: 'heart' },
  { name: 'Ecommerce', icon: 'cart' },
  { name: 'SaaS', icon: 'layers' },
  { name: 'Professional services', icon: 'case' },
];
const heroStats = [
  { n: `${work.length}`, l: 'Projects shipped' },
  { n: '4', l: 'Regions served' },
  { n: `${services.length}`, l: 'Services, one team' },
];

const main = services.filter((s) => s.pillar !== 'more');
const featured = ['erus-academy', 'auvia', 'baemeds-usa', 'the-qalb', 'talent-hunters-consulting', 'conavlytics', 'meduscore', 'baemeds-india'].map((s) => getWork(s)!);


const faqs = [
  { q: 'Do you work with clients outside India?', a: 'Yes. Most of our clients are in the United States and India, and we also work with businesses in the UK and the GCC. We schedule calls in your working hours and keep everything in writing.' },
  { q: 'Who will I actually be talking to?', a: 'The people doing the work. There’s no account manager in the middle; you talk directly to the lead on your project.' },
  { q: 'How do you price projects?', a: 'Every project is quoted after a first call. Builds are priced by milestone; ongoing work is a monthly plan.' },
  { q: 'Can you take over an existing website, store or app?', a: 'Yes. We review what’s there, fix anything urgent, and keep improving it.' },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base theme="lab" schema={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Zemprolabs', url: 'https://zemprolabs.com' }, faqLd]}>
  <!-- =========================================================
       HERO + MORPH (pinned): ribbon hero → tilted project board
       ========================================================= -->
  <section class="lab-stage relative" data-lab-stage>
    <div class="lab-stage-inner">
      <!-- full-screen ribbon backdrop -->
      <div class="lab-z-area" data-z-area>
        <canvas class="lab-z" data-ribbon aria-hidden="true"></canvas>
      </div>

      <!-- hero copy -->
      <div class="lab-hero-copy pointer-events-none absolute inset-0" data-lab-hero-copy>
        <div class="hero-wrap mx-auto flex h-full max-w-[90rem] flex-col px-5 md:px-10">
          <div class="lab-hero-main pointer-events-auto">
            <p class="hero-badge" data-hero-in><span class="hero-badge-dot"></span>Digital product &amp; growth studio</p>
            <h1 class="hero-h" data-split="load">
              Build, launch and grow your business <span class="lab-serif lab-grad-text hero-em">online.</span>
            </h1>
            <p class="hero-p" data-hero-in>
              We build websites, software and ecommerce platforms, then drive real growth with SEO, advertising and ongoing
              optimisation. End to end, under one roof.
            </p>
            <div class="hero-ctas" data-hero-in>
              <a href="/contact" class="lab-btn" data-magnetic="0.3">Start a project <span aria-hidden="true">→</span></a>
              <a href="/work" class="hero-ghost"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" /></svg>See our work</a>
            </div>
            <ul class="hero-pillars" data-hero-in>
              {heroPillars.map((p) => (
                <li>
                  <a href={p.href} class="hero-pillar">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      {p.icon === 'code' && <path d="M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16" />}
                      {p.icon === 'chart' && <path d="M4 20V13h4v7H4zM10 20V9h4v11h-4zM16 20V4h4v16h-4z" />}
                      {p.icon === 'layers' && <path d="M12 3l9 5-9 5-9-5 9-5zM3 12.5l9 5 9-5M3 16.5l9 5 9-5" />}
                    </svg>
                    <span><b>{p.name}</b><small>{p.line}</small></span>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="hero-trust pointer-events-auto" data-hero-in>
            <p class="hero-trust-label">Trusted by businesses across</p>
            <ul class="hero-sectors">
              {heroSectors.map((sct) => (
                <li>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    {sct.icon === 'heart' && <path d="M12 20s-7-4.4-9-9a4.8 4.8 0 0 1 9-3 4.8 4.8 0 0 1 9 3c-2 4.6-9 9-9 9zM3 12h4l2-3 3 6 2-3h7" />}
                    {sct.icon === 'cart' && <path d="M3 4h2.5l2.2 10.5h10.6L21 7H7M9.5 19.5a1 1 0 1 0 0 .01M17.5 19.5a1 1 0 1 0 0 .01" />}
                    {sct.icon === 'layers' && <path d="M12 3l9 5-9 5-9-5 9-5zM3 12.5l9 5 9-5M3 16.5l9 5 9-5" />}
                    {sct.icon === 'case' && <path d="M3 8h18v12H3zM9 8V5h6v3M3 13h18" />}
                  </svg>
                  {sct.name}
                </li>
              ))}
            </ul>
            <dl class="hero-stats">
              {heroStats.map((st) => (
                <div><dt>{st.l}</dt><dd>{st.n}</dd></div>
              ))}
            </dl>
          </div>
        </div>
      </div>

      <!-- laptop + phone (own layer so they can animate away on scroll) -->
      <div class="hero-dev-area" data-dev-area>
          <a href={`/work/${heroCase.slug}`} class="hero-dev" data-devices aria-label={`${heroCase.client}: see the case study`}>
            <span class="dev-glow" aria-hidden="true"></span>
            <span class="dev-stage">
              <span class="dev-laptop" data-dev-laptop>
                <span class="lap-lid">
                  <span class="lap-bezel">
                    <span class="lap-cam" aria-hidden="true"></span>
                    <span class="lap-display">
                      <Image src={heroCase.image!} alt={`${heroCase.client} website on a laptop`} widths={[800, 1200, 1600]} sizes="(min-width: 900px) 34vw, 70vw" class="dev-img" loading="eager" fetchpriority="high" />
                      <span class="dev-glare" aria-hidden="true"></span>
                    </span>
                  </span>
                </span>
                <span class="lap-base" aria-hidden="true"><span class="lap-notch"></span></span>
                <span class="lap-shadow" aria-hidden="true"></span>
              </span>
              <span class="dev-phone" data-dev-phone>
                <span class="ph-btn ph-btn-a" aria-hidden="true"></span>
                <span class="ph-btn ph-btn-b" aria-hidden="true"></span>
                <span class="ph-btn ph-btn-c" aria-hidden="true"></span>
                <span class="ph-body">
                  <span class="ph-display">
                    <Image src={heroCase.mobile!} alt={`${heroCase.client} website on a phone`} width={420} class="dev-img" loading="eager" />
                    <span class="ph-island" aria-hidden="true"></span>
                    <span class="dev-glare" aria-hidden="true"></span>
                  </span>
                </span>
              </span>
            </span>

            <span class="dev-chip chip-a" aria-hidden="true">
              <span class="chip-ico chip-live"></span>
              <span><b>Store live</b><small>Shopify · US checkout</small></span>
            </span>
            <span class="dev-chip chip-b" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="chip-svg"><path d="M7 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM10 18h4" /></svg>
              <span><b>Mobile ready</b><small>Same store, every screen</small></span>
            </span>
            <span class="dev-chip chip-c" aria-hidden="true">
              <span class="chip-bars"><i></i><i></i><i></i><i></i><i></i></span>
              <span><b>SEO + Ads</b><small>Running every month</small></span>
            </span>
            <span class="dev-tag" aria-hidden="true">{heroCase.client} · <b>view case study ↗</b></span>
          </a>
      </div>

      <!-- tilted project board (revealed by scroll) -->
      <div class="lab-board-wrap absolute inset-0" data-lab-board>
        <div class="mx-auto grid h-full max-w-[90rem] grid-cols-[minmax(0,1fr)] items-center gap-10 px-5 pt-24 pb-10 md:grid-cols-12 md:px-10 [&>*]:min-w-0">
          <div class="md:col-span-4">
            <p class="lab-mono text-[var(--lab-soft)]">02 — Clients &amp; services</p>
            <h2 class="lab-h mt-5 text-[clamp(2rem,3.6vw,3.4rem)]">Build it. Grow it. <span class="lab-serif lab-grad-text">Run it.</span></h2>
            <p class="mt-6 max-w-sm text-[0.95rem] leading-relaxed text-[var(--lab-soft)]">
              Clinics in Texas, learning platforms and stores in India, recruiters in the UK and the Gulf. Most of them still
              work with us today.
            </p>
            <div class="mt-8 flex items-center gap-6">
              <a href="/work" class="lab-btn">See all work</a>
              <a href="/services" class="lab-bracket">Services</a>
            </div>
          </div>
          <div class="lab-board-scene relative md:col-span-8" aria-label="Featured projects">
            <div class="lab-board" data-lab-board-panel>
              <div class="lab-board-side">
                <p class="lab-mono text-[var(--lab-soft)]">Zemprolabs · Board</p>
                <ul class="mt-4 space-y-2.5">
                  {main.map((s, i) => (
                    <li class="flex items-center justify-between text-[0.8rem]">
                      <span class="flex items-center gap-2"><span class="size-2 rounded-full" style={`background:${rowColors[i % rowColors.length]}`}></span>{s.name}</span>
                      <span class="lab-mono text-[var(--lab-soft)]">0{i + 1}</span>
                    </li>
                  ))}
                </ul>
                <div class="mt-auto flex items-center gap-2 rounded-xl bg-white p-2.5">
                  <span class="grid size-7 place-items-center rounded-full bg-[var(--lab-ink)] text-[0.65rem] text-white">ZL</span>
                  <span class="text-[0.72rem] leading-tight">Your team<br /><span class="text-[var(--lab-soft)]">Hyderabad</span></span>
                </div>
              </div>
              <ul class="lab-board-rows">
                {boardRows.map(({ item, color }, i) => (
                  <li class="lab-row" style={`--c:${color};--i:${i}`} data-lab-row>
                    <a href={`/work/${item.slug}`} class="flex h-full items-center gap-3 px-3.5">
                      <span class="grid size-8 shrink-0 place-items-center rounded-full bg-white/25 text-[0.68rem] font-semibold text-white">{item.client.slice(0, 2).toUpperCase()}</span>
                      <span class="min-w-0 flex-1">
                        <span class="block truncate text-[0.8rem] font-semibold text-white">{item.client}</span>
                        <span class="block truncate text-[0.68rem] text-white/80">{item.sector} · {item.location}</span>
                      </span>
                      <span class="rounded-full bg-white/90 px-2.5 py-1 text-[0.62rem] font-semibold" style={`color:${color}`}>{item.status === 'Ongoing' ? 'Building' : item.status}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       SERVICES
       ========================================================= -->
  <HomeServices />

  <!-- =========================================================
       WORK (horizontal on desktop)
       ========================================================= -->
  <section class="relative overflow-hidden lg:h-screen" data-hscroll>
    <div class="flex h-full flex-col justify-center py-24 lg:py-0">
      <div class="mx-auto flex w-full max-w-[90rem] flex-wrap items-end justify-between gap-6 px-5 md:px-10">
        <div>
          <p class="lab-mono text-[var(--lab-soft)]" data-reveal>04 — Work</p>
          <h2 class="lab-h mt-5 text-[clamp(2.2rem,5vw,4.6rem)]" data-split>Real businesses, <span class="lab-serif lab-grad-text">still running.</span></h2>
        </div>
        <a href="/work" class="lab-bracket" data-reveal>All {work.length} projects</a>
      </div>
      <div class="mt-12 overflow-x-auto pb-4 lg:overflow-visible lg:pb-0 [scrollbar-width:none]">
        <div class="flex w-max gap-5 px-5 md:px-10" data-hscroll-track>
          {featured.map((item, i) => (
            <a href={`/work/${item.slug}`} class="lab-work group block w-[78vw] shrink-0 sm:w-[46vw] lg:w-[34vw]" data-cursor="View" data-media>
              <div class="relative aspect-[16/10] overflow-hidden rounded-[22px] bg-white p-2.5 shadow-[0_40px_80px_-50px_rgba(17,17,20,0.5)]">
                <div class="relative size-full overflow-hidden rounded-[14px]">
                  {item.image && (
                    <Image src={item.image} alt={`${item.client} by Zemprolabs`} widths={[600, 1000, 1400]} sizes="(min-width: 1024px) 34vw, 78vw" class="size-full object-cover object-top transition-transform duration-[1.2s] ease-[var(--ease-out-soft)] group-hover:scale-[1.04]" loading="lazy" />
                  )}
                  <span class="absolute top-3 left-3 rounded-full px-3 py-1 text-[0.68rem] font-semibold text-white" style={`background:${rowColors[i % rowColors.length]}`}>{item.sector}</span>
                </div>
              </div>
              <div class="mt-4 flex items-start justify-between gap-4">
                <div>
                  <p class="lab-mono text-[var(--lab-soft)]">{String(i + 1).padStart(2, '0')} · {item.client}</p>
                  <p class="lab-caption mt-2 text-[1.3rem]">{item.headline}</p>
                </div>
                <span class="grid size-10 shrink-0 place-items-center rounded-full bg-[var(--lab-ink)] text-white transition-transform duration-500 group-hover:rotate-45" aria-hidden="true">↗</span>
              </div>
            </a>
          ))}
        </div>
      </div>
      <div class="mx-auto mt-10 hidden w-full max-w-[90rem] px-10 lg:block">
        <div class="h-[2px] w-full rounded bg-[var(--lab-line)]"><div class="h-[2px] origin-left scale-x-0 rounded" style="background:var(--lab-grad)" data-hscroll-bar></div></div>
      </div>
    </div>
  </section>

  <!-- clients marquee (replaces the numbers band) -->
  <HomeMarquee />

  <!-- =========================================================
       FAQ
       ========================================================= -->
  <section class="mx-auto max-w-[90rem] px-5 py-24 md:px-10 md:py-32">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-4">
        <p class="lab-mono text-[var(--lab-soft)]" data-reveal>05 — Questions</p>
        <h2 class="lab-h mt-5 text-[clamp(2rem,4vw,3.4rem)]" data-split>Good to know.</h2>
      </div>
      <div class="md:col-span-8">
        {faqs.map((f, i) => (
          <details class="lab-faq group border-t border-[var(--lab-line)] last:border-b" data-reveal>
            <summary class="flex cursor-pointer list-none items-center gap-6 py-6 [&::-webkit-details-marker]:hidden">
              <span class="lab-mono w-6 text-[var(--lab-soft)]">0{i + 1}</span>
              <span class="flex-1 text-[1.05rem] font-medium md:text-[1.2rem]">{f.q}</span>
              <span class="faq-plus grid size-9 place-items-center rounded-full border border-[var(--lab-line)] transition-all duration-500 group-open:rotate-45 group-open:border-transparent group-open:text-white" aria-hidden="true">+</span>
            </summary>
            <p class="max-w-2xl pb-7 pl-12 text-[0.95rem] leading-relaxed text-[var(--lab-soft)]">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================
       CTA
       ========================================================= -->
  <section class="px-5 pb-24 md:px-10 md:pb-32">
    <div class="lab-cta lab-dark relative mx-auto max-w-[90rem] overflow-hidden rounded-[32px] px-6 py-20 text-center md:py-28">
      <div class="lab-cta-slabs" aria-hidden="true">
        {Array.from({ length: 28 }, (_, k) => <span style={`--k:${k}`}></span>)}
      </div>
      <div class="relative">
        <p class="lab-mono text-[var(--lab-soft)]" data-reveal>06 — Start</p>
        <h2 class="lab-h mx-auto mt-5 max-w-[16ch] text-[clamp(2.4rem,6vw,5.5rem)]" data-split>Are you ready to take the <span class="lab-serif lab-grad-text">first step?</span></h2>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-6" data-reveal>
          <a href="/contact" class="lab-btn" data-magnetic="0.3">Start a project <span aria-hidden="true">→</span></a>
          <a href={site.phones[0].whatsapp} class="lab-bracket" rel="noopener">WhatsApp us</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- pinned stage ---------- */
  .lab-stage-inner { position: relative; }
  .lab-hero-copy { position: relative; }
  .lab-board-wrap { position: relative; }
  /* ---------- hero: copy left, ribbon + laptop and phone right ---------- */
  .lab-z-area { position: relative; height: 40vh; margin-top: 5rem; z-index: 0; }
  .lab-z { display: block; width: 100%; height: 100%; touch-action: pan-y; }
  /* laptop + phone: CSS devices in perspective, floating cards, light parallax */
  .hero-dev { position: absolute; inset: 0; display: block; --mx: 0; --my: 0; perspective: 1600px; }
  .dev-glow { position: absolute; left: 14%; right: 10%; top: 22%; bottom: 14%; border-radius: 50%; background: radial-gradient(closest-side, rgba(255, 122, 47, 0.28), rgba(184, 50, 110, 0.16) 55%, transparent); filter: blur(34px); }
  .dev-stage { position: absolute; inset: 0; transform-style: preserve-3d; transform: rotateY(calc(-10deg + var(--mx) * 4deg)) rotateX(calc(4deg - var(--my) * 2deg)); transition: transform 0.9s var(--ease-out-soft); }
  .dev-img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .dev-glare { position: absolute; inset: 0; border-radius: inherit; background: linear-gradient(118deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0.04) 34%, rgba(255, 255, 255, 0) 35%); pointer-events: none; }

  /* laptop: aluminium lid with a thin black bezel, slim base with a thumb notch */
  .dev-laptop { position: absolute; left: 12%; width: 66%; top: 50%; display: block; transform-style: preserve-3d; transform: translateY(calc(-50% + var(--lid) * 6%)) scale(calc(1 - var(--lid) * 0.12)); }
  .lap-lid { transform-origin: 50% 100%; transform: rotateX(calc(var(--lid) * -84deg)); }
  .lap-lid { display: block; padding: 0.55%; border-radius: 14px 14px 4px 4px; background: linear-gradient(180deg, #d9d6d6, #b9b5b6); box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.18), 0 30px 60px -30px rgba(40, 14, 30, 0.55); }
  .lap-bezel { position: relative; display: block; padding: 3.2% 2% 2.4%; border-radius: 10px 10px 2px 2px; background: #0d0c0f; }
  .lap-cam { position: absolute; left: 50%; top: 1.3%; width: 5px; height: 5px; margin-left: -2.5px; border-radius: 50%; background: #23212a; box-shadow: inset 0 0 0 1.5px #1a1820; }
  .lap-display { position: relative; display: block; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 3px; background: #111; }
  .lap-display .dev-img { object-position: left top; }
  .lap-base { position: relative; display: block; height: 0; margin: 0 -7.5%; padding-bottom: 3.8%; border-radius: 2px 2px 40% 40% / 2px 2px 100% 100%; background: linear-gradient(180deg, #e4e1e1 0%, #bdb9ba 40%, #8a8587 100%); box-shadow: 0 1px 0 rgba(255, 255, 255, 0.8) inset, 0 0 0 1px rgba(0, 0, 0, 0.2), 0 18px 30px -12px rgba(40, 14, 30, 0.45); }
  .lap-notch { position: absolute; left: 50%; top: 0; width: 15%; height: 42%; margin-left: -7.5%; border-radius: 0 0 9px 9px; background: linear-gradient(180deg, #b2aeaf, #cfcccc); }
  .lap-shadow { position: absolute; left: -4%; right: -4%; bottom: -5%; height: 8%; border-radius: 50%; background: radial-gradient(closest-side, rgba(40, 14, 30, 0.35), transparent); filter: blur(6px); z-index: -1; }

  /* phone: titanium frame, side buttons, black bezel, Dynamic Island */
  .dev-phone { position: absolute; right: 9%; bottom: 13%; display: block; width: 17%; aspect-ratio: 9 / 19.3; transform: translateZ(80px) rotateY(-6deg) rotateZ(calc(3deg + var(--out) * 18deg)) translate(calc(var(--mx) * 12px + var(--out) * 38vw), calc(var(--my) * 9px - var(--out) * 12vh)); opacity: calc(1 - var(--out) * 0.4); transition: transform 0.7s var(--ease-out-soft); }
  .ph-body { position: absolute; inset: 0; display: block; padding: 3.2%; border-radius: 17% / 8%; background: linear-gradient(135deg, #9a959c, #5f5a62 40%, #8e8990); box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.35), 0 40px 60px -26px rgba(40, 14, 30, 0.6); }
  .ph-display { position: relative; display: block; width: 100%; height: 100%; overflow: hidden; border-radius: 14% / 6.6%; background: #000; box-shadow: 0 0 0 2.5px #050506; }
  .ph-island { position: absolute; left: 50%; top: 2.2%; width: 32%; height: 3.4%; margin-left: -16%; border-radius: 999px; background: #000; }
  .ph-btn { position: absolute; display: block; width: 2.5%; border-radius: 2px; background: linear-gradient(90deg, #6f6a72, #a19ca3); }
  .ph-btn-a { left: -1.6%; top: 18%; height: 6%; }
  .ph-btn-b { left: -1.6%; top: 27%; height: 10%; }
  .ph-btn-c { right: -1.6%; top: 24%; height: 13%; }
  .hero-dev:hover .dev-phone { transform: translateZ(120px) rotateY(-3deg) rotateZ(calc(0.5deg + var(--out) * 18deg)) translate(calc(var(--mx) * 12px + var(--out) * 38vw), calc(var(--my) * 9px - 10px - var(--out) * 12vh)); }

  .dev-chip { position: absolute; display: flex; align-items: center; gap: 0.65rem; padding: 0.6rem 0.95rem 0.6rem 0.65rem; border-radius: 16px; background: rgba(255, 255, 255, 0.72); backdrop-filter: blur(12px) saturate(1.4); -webkit-backdrop-filter: blur(12px) saturate(1.4); border: 1px solid rgba(255, 255, 255, 0.85); box-shadow: 0 20px 40px -22px rgba(40, 14, 30, 0.45); color: var(--lab-ink); white-space: nowrap; animation: chip-float 6s ease-in-out infinite; }
