---
interface Props { class?: string; inverted?: boolean }
const { class: cls = '', inverted = false } = Astro.props;
// Light variant for dark backgrounds: the forest parts switch to mist so the mark stays visible.
const bottom = inverted ? '#9DB2AA' : '#1F3A33';
const diagEnd = inverted ? '#9DB2AA' : '#1F3A33';
const diagMid = inverted ? '#B9C8C2' : '#2C4D44';
const gid = `zl-g-${inverted ? 'i' : 'n'}`;
---

<a href="/" class={`group inline-flex items-center gap-2.5 ${cls}`} aria-label="Zemprolabs home">
  <svg
    class="size-9 shrink-0 transition-transform duration-500 ease-[var(--ease-out-soft)] group-hover:-rotate-6"
    viewBox="0 0 100 100"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id={gid} x1="90" y1="26" x2="10" y2="74" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#D2582A" />
        <stop offset="0.44" stop-color="#C2481B" />
        <stop offset="0.56" stop-color={diagMid} />
        <stop offset="1" stop-color={diagEnd} />
      </linearGradient>
    </defs>
    <path d="M14 10 H90 V26 H10 V14 Q10 10 14 10 Z" fill="#C2481B" />
    <path d="M64 26 H90 L36 74 H10 Z" fill={`url(#${gid})`} />
    <path d="M64 26 H90 L85.5 30 H59.5 Z" fill="#000" fill-opacity="0.22" />
    <path d="M14.5 70 H40.5 L36 74 H10 Z" fill="#000" fill-opacity={inverted ? '0.12' : '0.22'} />
    <path d="M10 74 H90 V86 Q90 90 86 90 H10 Z" fill={bottom} />
  </svg>
  <span class:list={['logo-word text-[1.1875rem] font-semibold tracking-[-0.035em]', inverted ? 'text-paper' : 'text-current']}>
    zemprolabs
  </span>
</a>
