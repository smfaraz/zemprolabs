<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} · {{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="https://{{ site.domain }}{{ page.url }}">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title }} · {{ site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="https://{{ site.domain }}{{ page.url }}">
  <meta property="og:image" content="https://{{ site.domain }}/images/og-default.png">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }} · {{ site.name }}">
  <meta name="twitter:description" content="{{ description or site.description }}">

  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">

  <!-- Fonts: swap for self-hosted files in production -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Zemprolabs",
    "url": "https://{{ site.domain }}",
    "description": "{{ site.description }}",
    "email": "{{ site.email }}"
  }
  </script>

  {{ structuredData | safe if structuredData }}
</head>
<body>

  <div class="statusbar">
    <div class="statusbar__inner">
      <span><span class="statusbar__dot"></span>zemprolabs — status: online</span>
      <span class="statusbar__right">
        <span>build: software × marketing × support</span>
        <span>{{ site.email }}</span>
      </span>
    </div>
  </div>

  <header class="site-header">
    <nav class="nav">
      <a href="/" class="logo" aria-label="Zemprolabs home">
        <span class="logo__bracket">&lt;</span>zemprolabs<span class="logo__bracket">/&gt;</span>
      </a>
      <ul class="nav__links">
        {% for item in site.primaryNav %}
        <li><a href="{{ item.url }}" class="{{ 'active' if (item.url != '/' and page.url.startsWith(item.url)) or page.url == item.url }}">{{ item.title }}</a></li>
        {% endfor %}
        <li class="mobile-only"><a href="/contact/" class="btn btn-primary btn-mono">Start a project →</a></li>
      </ul>
      <a href="/contact/" class="btn btn-primary btn-mono nav__cta desktop-only">Start a project →</a>
      <button class="nav__toggle" aria-label="Toggle menu" aria-expanded="false">
        <svg width="18" height="14" viewBox="0 0 18 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0 1H18M0 7H18M0 13H18" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </button>
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <a href="/" class="logo" style="margin-bottom: 1rem; display: inline-flex;">
            <span class="logo__bracket">&lt;</span>zemprolabs<span class="logo__bracket">/&gt;</span>
          </a>
          <p class="max-w" style="max-width: 34ch;">{{ site.tagline }}</p>
        </div>
        <div>
          <h5>Services</h5>
          <ul>
            {% for item in site.footerNav %}
            <li><a href="{{ item.url }}">{{ item.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
        <div>
          <h5>Company</h5>
          <ul>
            <li><a href="/about/">About</a></li>
            <li><a href="/work/">Work</a></li>
            <li><a href="/process/">Process</a></li>
            <li><a href="/pricing/">Pricing</a></li>
          </ul>
        </div>
        <div>
          <h5>Get in touch</h5>
          <ul>
            <li><a href="/contact/">Start a project</a></li>
            <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {{ "now" | year }} {{ site.name }}. All rights reserved.</span>
        <span>Built with HTML, CSS, JS — no framework.</span>
      </div>
    </div>
  </footer>

  <script src="/js/main.js" defer></script>
</body>
</html>
