---
import Base from '@/layouts/Base.astro';
import ScreenFrame from '@/components/ScreenFrame.astro';
import CaseGallery from '@/components/CaseGallery.astro';
import { getImage } from 'astro:assets';
import { work, type CaseStudy } from '@/data/work';
import { getService } from '@/data/services';
import { site } from '@/data/site';

export function getStaticPaths() {
  return work.map((w, i) => ({ params: { slug: w.slug }, props: { item: w, next: work[(i + 1) % work.length], n: i } }));
}

const { item, next, n } = Astro.props as { item: CaseStudy; next: CaseStudy; n: number };
const svc = item.services.map((s) => getService(s)!).filter(Boolean);
const og = item.image ? (await getImage({ src: item.image, width: 1200, height: 630, format: 'jpg', fit: 'cover' })).src : undefined;


const facts = [
  { k: 'Client', v: item.client },
  { k: 'Sector', v: item.sector },
  { k: 'Location', v: item.location },
  { k: 'Status', v: item.status },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: `${item.client}: ${item.headline}`,
    description: item.summary,
    creator: { '@id': `${site.url}/#org` },
    url: `${site.url}/work/${item.slug}`,
    ...(og ? { image: new URL(og, site.url).href } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Work', item: `${site.url}/work` },
      { '@type': 'ListItem', position: 2, name: item.client, item: `${site.url}/work/${item.slug}` },
    ],
  },
];
---

<Base title={`${item.client} Case Study`} description={item.summary} image={`/og/work-${item.slug}.jpg`} schema={schema}>
  <article>
    <header class="wrap pt-36 pb-12 md:pt-48 md:pb-16">
      <div class="flex items-center justify-between">
        <nav class="label flex items-center gap-2" aria-label="Breadcrumb" data-reveal>
          <a href="/work" class="link-u hover:text-ink">Work</a><span>/</span><span class="label-ember">{item.client}</span>
        </nav>
        <p class="label hidden md:block" data-reveal>Case {String(n + 1).padStart(2, '0')} / {String(work.length).padStart(2, '0')}</p>
      </div>
      <h1 class="display mt-8 max-w-[18ch] text-[clamp(2.04rem,5.1vw,4.93rem)]" data-split="load">{item.headline}</h1>
      <div class="mt-12 grid gap-8 md:grid-cols-12 md:items-end">
        <p class="text-lg text-ink-soft md:col-span-6 md:text-xl" data-reveal>{item.summary}</p>
        <div class="flex flex-wrap gap-2 md:col-span-5 md:col-start-8 md:justify-end" data-reveal>
          {svc.map((s) => <a href={`/services/${s.slug}`} class="chip transition-colors hover:border-forest hover:bg-forest hover:text-paper">{s.name}</a>)}
        </div>
      </div>
    </header>

    <div class="wrap">
      <div class="overflow-hidden rounded-[14px]" data-mask>
        <div>
          <ScreenFrame item={item} size="hero" eager play="auto" zoom={false} sizes="(min-width: 768px) 70vw, 100vw" />
        </div>
      </div>
    </div>


    <section class="wrap grid gap-14 py-24 md:grid-cols-12 md:py-36">
      <aside class="md:col-span-4">
        <div class="md:sticky md:top-28">
          <dl class="overflow-hidden rounded-[14px] bg-sand" data-reveal>
            {facts.map((f) => (
              <div class="flex justify-between gap-4 border-b border-line px-6 py-4 text-[0.9375rem]">
                <dt class="label">{f.k}</dt>
                <dd class="text-right font-medium">{f.v}</dd>
              </div>
            ))}
            <div class="px-6 py-5">
              <dt class="label">Built with</dt>
              <dd class="mt-3 flex flex-wrap gap-1.5">{item.stack.map((t) => <span class="chip bg-paper">{t}</span>)}</dd>
            </div>
          </dl>
          {item.url && (
            <a href={item.url} target="_blank" rel="noopener" class="btn btn-primary mt-6 w-full justify-between" data-reveal>
              Visit {new URL(item.url).hostname.replace('www.', '')} <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </aside>

      <div class="space-y-20 md:col-span-7 md:col-start-6">
        <section>
          <p class="label label-ember" data-reveal>01 · The challenge</p>
          <p class="display mt-6 text-[clamp(1.19rem,2.04vw,1.87rem)] leading-[1.15]" data-scrub-text>{item.challenge}</p>
        </section>
        <section data-reveal>
          <p class="label label-ember">02 · What we did</p>
          <p class="mt-6 text-lg leading-relaxed text-ink-soft md:text-xl">{item.approach}</p>
        </section>
        <section>
          <p class="label label-ember" data-reveal>03 · What we delivered</p>
          <ul class="mt-6">
            {item.delivered.map((d, i) => (
              <li class="flex items-baseline gap-6 border-b border-line py-5 first:border-t" data-reveal>
                <span class="label w-8 shrink-0">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-lg">{d}</span>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </section>

    <CaseGallery item={item} />
  </article>

  <a href={`/work/${next.slug}`} class="group block bg-deep text-paper" data-media data-cursor="Next">
    <div class="wrap grid items-center gap-10 py-20 md:grid-cols-12 md:py-28">
      <div class="md:col-span-6">
        <p class="label !text-mist">Next case study</p>
        <p class="display mt-5 text-[clamp(1.7rem,3.74vw,3.4rem)] transition-colors duration-300 group-hover:text-ember-soft">{next.client}</p>
        <p class="mt-4 max-w-md text-mist">{next.headline}</p>
      </div>
      <div class="md:col-span-6">
        <ScreenFrame item={next} sizes="(min-width: 768px) 45vw, 90vw" />
      </div>
    </div>
  </a>
</Base>
