---

import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHead from '@/components/SectionHead.astro';
import FormShell from '@/components/FormShell.astro';
import WorkMosaic from '@/components/WorkMosaic.astro';

const areas = [
  { t: 'Full-stack engineering', d: 'React, Next.js, Node.js and TypeScript. Building websites, portals and SaaS products for real clients.', you: 'You write clean, typed code and care how it feels to use.', tags: ['TypeScript', 'React', 'Next.js', 'Node.js', 'PostgreSQL'] },
  { t: 'E-commerce & Shopify', d: 'Shopify themes, apps and checkout setups for brands selling in the US and India.', you: 'You know Liquid and the Storefront API, and you think about conversion.', tags: ['Shopify', 'Liquid', 'Storefront API', 'Stripe'] },
  { t: 'ServiceNow', d: 'ITSM, IRM/GRC and CMDB work on enterprise platforms, including Flow Designer automation.', you: 'You’ve shipped on a real instance and respect the release process.', tags: ['ITSM', 'IRM', 'Flow Designer', 'JavaScript'] },
  { t: 'SEO, ads & growth', d: 'Technical SEO, Google and Meta campaigns and social media, measured on leads and sales.', you: 'You’re comfortable in Search Console, Ads Manager and a spreadsheet.', tags: ['SEO', 'Google Ads', 'Meta Ads', 'Analytics'] },
];

const steps = [
  { t: 'Apply', d: 'Send the form below with a link to your CV, LinkedIn or portfolio.' },
  { t: 'Intro call', d: 'A relaxed 30-minute chat about you and what you want to work on.' },
  { t: 'Practical round', d: 'A short, realistic task or a walk-through of something you’ve built.' },
  { t: 'Offer', d: 'Meet the team, ask anything, and get a clear written offer.' },
];

const perks = ['Real client work from week one', 'Small team, no bureaucracy', 'Hyderabad studio or remote in India', 'Work across the US, UK, GCC and India'];
---

<Base
  image="/og/careers.jpg"
  title="Careers"
  description="Careers at Zemprolabs. Engineering, Shopify, ServiceNow and growth roles in Hyderabad and remote across India. Send us your profile."
>
  <PageHero
    eyebrow="Careers"
    index="Hyderabad & remote in India"
    title="Do your best work on <em class='accent'>real businesses.</em>"
    lead="We’re a small team, so your work goes live and matters. Clients across four regions; projects from first sketch to years of looking after them."
  >
    <div class="mt-10 flex flex-wrap items-center gap-3" data-reveal>
      <a href="#apply" class="btn btn-primary">Apply now <span class="arrow" aria-hidden="true">↓</span></a>
      <ul class="flex flex-wrap gap-2">{perks.map((p) => <li class="chip">{p}</li>)}</ul>
    </div>
  </PageHero>

  <WorkMosaic slugs={['baemeds-usa', 'auvia', 'conavlytics']} caption="The kind of work you’ll do: real clients, real launches" />

  <section class="wrap py-24 md:py-36">
    <SectionHead label="Who we’re looking for" title="Good people in <em>four areas.</em>" lead="We don’t always have open roles listed, but we always want to hear from people who are great at one of these." />
    <div class="mt-16 grid gap-4 md:grid-cols-2">
      {areas.map((a, i) => (
        <details class="area group rounded-[16px] bg-sand transition-colors duration-500 open:bg-forest open:text-paper" data-reveal>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 p-7 md:p-9 [&::-webkit-details-marker]:hidden">
            <div>
              <span class="label group-open:!text-mist">0{i + 1}</span>
              <h3 class="display mt-4 text-[1.53rem] leading-none md:text-[1.87rem]">{a.t}</h3>
            </div>
            <span class="grid size-11 shrink-0 place-items-center rounded-full border border-line text-lg transition-all duration-500 group-open:rotate-45 group-open:border-ember group-open:bg-ember" aria-hidden="true">+</span>
          </summary>
          <div class="px-7 pb-8 md:px-9">
            <p class="text-lg">{a.d}</p>
            <p class="mt-3 text-mist">{a.you}</p>
            <ul class="mt-6 flex flex-wrap gap-1.5">{a.tags.map((t) => <li class="chip border-deep-line">{t}</li>)}</ul>
          </div>
        </details>
      ))}
    </div>
  </section>

  <section class="border-t border-line" data-process>
    <div class="wrap py-24 md:py-32">
      <SectionHead label="How hiring works" title="Four steps, <em>no runaround.</em>" />
      <div class="relative mt-16">
        <div class="absolute top-[11px] right-0 left-0 hidden h-px bg-line lg:block"></div>
        <div class="absolute top-[11px] right-0 left-0 hidden h-px origin-left bg-ember lg:block" data-process-line></div>
        <div class="absolute top-0 bottom-0 left-[11px] w-px bg-line lg:hidden"></div>
        <div class="absolute top-0 bottom-0 left-[11px] w-px origin-top bg-ember lg:hidden" data-process-line="y"></div>
        <ol class="relative grid gap-12 lg:grid-cols-4 lg:gap-8">
          {steps.map((s, i) => (
            <li class="step pl-12 lg:pl-0" data-process-step>
              <span class="step-dot absolute left-0 grid size-[23px] place-items-center rounded-full border border-line bg-paper transition-colors duration-500 lg:relative">
                <span class="size-[7px] rounded-full bg-line transition-colors duration-500"></span>
              </span>
              <p class="label lg:mt-8">Step 0{i + 1}</p>
              <h3 class="display mt-3 text-3xl">{s.t}</h3>
              <p class="mt-3 text-[0.9375rem] text-ink-soft">{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section id="apply" class="scroll-mt-24 bg-sand">
    <div class="wrap grid gap-14 py-24 md:py-32 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="label label-ember" data-reveal>Apply</p>
        <h2 class="display mt-6 text-[clamp(1.7rem,3.4vw,3.06rem)]" data-split>Send us your <em>profile.</em></h2>
        <p class="mt-6 text-ink-soft" data-reveal>Share a link to your CV, LinkedIn or portfolio. Google Drive, Dropbox and GitHub links all work.</p>
      </div>
      <div class="lg:col-span-7 lg:col-start-6" data-reveal>
        <FormShell id="careers-form" subject="New job application: zemprolabs.com" submitLabel="Send application">
          <div class="grid gap-7 sm:grid-cols-2">
            <label class="field"><span>Name</span><input class="input" name="name" autocomplete="name" required /></label>
            <label class="field"><span>Email</span><input class="input" type="email" name="email" autocomplete="email" required /></label>
            <label class="field"><span>Phone <i>(optional)</i></span><input class="input" type="tel" name="phone" autocomplete="tel" /></label>
            <label class="field">
              <span>Area</span>
              <select class="input" name="area" required>
                <option value="" disabled selected>Choose one</option>
                {areas.map((a) => <option>{a.t}</option>)}
                <option>Something else</option>
              </select>
            </label>
            <label class="field"><span>City</span><input class="input" name="city" autocomplete="address-level2" required /></label>
            <label class="field">
              <span>Years of experience</span>
              <select class="input" name="experience" required>
                <option value="" disabled selected>Choose one</option>
                <option>0–1</option><option>1–3</option><option>3–5</option><option>5–8</option><option>8+</option>
              </select>
            </label>
            <label class="field sm:col-span-2"><span>CV, LinkedIn or portfolio link</span><input class="input" type="url" name="profile_link" placeholder="https://" required /></label>
            <label class="field sm:col-span-2"><span>Anything you’d like us to know? <i>(optional)</i></span><textarea class="input min-h-28 resize-y" name="message" rows="4"></textarea></label>
          </div>
        </FormShell>
      </div>
    </div>
  </section>
</Base>

<style>
  .area:not([open]) .chip { border-color: var(--color-line); }
  .step.is-on .step-dot { border-color: var(--color-ember); }
  .step.is-on .step-dot > span { background: var(--color-ember); }
  html:not(.motion) .step .step-dot { border-color: var(--color-ember); }
  html:not(.motion) .step .step-dot > span { background: var(--color-ember); }
</style>
