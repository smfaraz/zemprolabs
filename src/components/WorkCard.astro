---
import ScreenFrame from './ScreenFrame.astro';
import type { CaseStudy } from '@/data/work';

interface Props { item: CaseStudy; dark?: boolean; index?: number; sizes?: string }
const { item, dark = false, index, sizes } = Astro.props;
---

<article class="group" data-reveal>
  <a href={`/work/${item.slug}`} class="block" data-media data-cursor="View">
    <ScreenFrame item={item} sizes={sizes} />
    <div class="mt-5 flex items-start justify-between gap-6">
      <div class="min-w-0">
        <p class:list={['label flex flex-wrap items-center gap-x-2 gap-y-1', dark && '!text-mist']}>
          {index !== undefined && <span>{String(index + 1).padStart(2, '0')}</span>}
          <span>{item.client}</span>
          <span aria-hidden="true">·</span>
          <span>{item.sector}</span>
          {item.status === 'Ongoing' && <span class="rounded-full bg-ember px-2 py-0.5 !text-paper">In progress</span>}
        </p>
        <h3 class="lab-caption mt-2.5 text-[clamp(1.1rem,1.5vw,1.4rem)]">{item.headline}</h3>
      </div>
      <span
        class:list={[
          'mt-1 grid size-11 shrink-0 place-items-center rounded-full border transition-all duration-500 group-hover:rotate-45',
          dark ? 'border-deep-line group-hover:border-ember group-hover:bg-ember' : 'border-line group-hover:border-forest group-hover:bg-forest group-hover:text-paper',
        ]}
        aria-hidden="true"
      >↗</span>
    </div>
  </a>
</article>
