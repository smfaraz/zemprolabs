# Zemprolabs Production Environment Configuration Example
# Copy this file to .env.local for local overrides.
# NOTE: Never commit sensitive private credentials or secrets here.

# Public Contact Form Gateway Endpoint (Optional)
# If provided, submissions from the contact form are POSTed directly to this URL as JSON.
# If unset or empty, the application gracefully provides direct email (info@zemprolabs.com)
# and WhatsApp (+91 744 755 7577) client-side dispatch options.
VITE_CONTACT_ENDPOINT=""
