---
/**
 * About 02 — "From Hyderabad, to everywhere".
 * A dotted world map (rasterised here at build time from rough continent outlines),
 * with arcs that draw out from Hyderabad as you scroll and client cards landing at each end.
 */
import { Image } from 'astro:assets';
import bmUs from '@/assets/work/baemeds-usa-1.jpg';
import med from '@/assets/work/meduscore-1.jpg';
import thc from '@/assets/work/talent-hunters-consulting-1.jpg';
import erus from '@/assets/work/erus-academy-1.jpg';

// rough continent outlines, [lon, lat]
const land: [number, number][][] = [
  [[-168,66],[-162,70],[-140,70],[-120,72],[-95,74],[-80,72],[-62,66],[-55,52],[-66,45],[-75,38],[-80,32],[-81,25],[-90,30],[-97,26],[-97,20],[-90,16],[-84,10],[-78,8],[-85,14],[-95,16],[-105,20],[-112,30],[-118,34],[-124,40],[-124,48],[-135,58],[-150,60],[-165,60]],
  [[-55,60],[-44,60],[-20,70],[-20,80],[-60,82],[-72,78],[-56,70]],
  [[-78,8],[-60,10],[-50,0],[-35,-6],[-40,-22],[-48,-28],[-58,-38],[-65,-42],[-68,-54],[-74,-52],[-72,-40],[-71,-18],[-76,-14],[-81,-5],[-80,2]],
  [[-10,36],[-9,43],[-2,44],[-5,48],[2,51],[8,54],[8,57],[5,62],[15,69],[28,71],[40,68],[45,60],[40,48],[30,45],[28,41],[22,40],[18,40],[12,44],[16,38],[10,44],[3,42],[-2,37]],
  [[-6,50],[2,51],[0,54],[-3,58],[-6,57],[-5,54]],
  [[-17,15],[-10,28],[-6,35],[10,37],[20,32],[32,31],[35,28],[43,12],[51,12],[40,-3],[40,-15],[35,-24],[27,-34],[18,-34],[12,-18],[13,-5],[9,4],[-5,5],[-12,8]],
  [[44,-25],[50,-15],[49,-12],[44,-17]],
  [[35,30],[36,36],[45,38],[48,30],[56,26],[60,22],[56,17],[45,13],[38,20],[34,28]],
  [[26,40],[30,45],[40,48],[45,60],[40,68],[60,70],[80,73],[100,77],[120,73],[140,72],[170,70],[180,66],[175,62],[160,60],[155,52],[142,54],[135,44],[128,36],[122,30],[120,22],[108,20],[106,10],[100,13],[100,4],[98,8],[94,17],[90,22],[86,20],[80,15],[77,8],[73,18],[67,25],[60,25],[56,27],[48,30],[45,38],[36,36]],
  [[95,5],[106,-6],[115,-8],[118,0],[117,7],[110,2],[100,0]],
  [[130,31],[140,35],[142,42],[141,45],[138,38],[131,34]],
  [[114,-22],[122,-18],[130,-12],[137,-12],[142,-11],[146,-19],[153,-26],[150,-37],[140,-38],[131,-31],[115,-34]],
];
const inside = (x: number, y: number, poly: [number, number][]) => {
  let c = false;
  for (let i = 0, j = poly.length - 1; i < poly.length; j = i++) {
    const [xi, yi] = poly[i], [xj, yj] = poly[j];
    if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) c = !c;
  }
  return c;
};
const W = 1000, H = 420, top = 80, bottom = -56;
const px = (lon: number) => ((lon + 180) / 360) * W;
const py = (lat: number) => ((top - lat) / (top - bottom)) * H;
const dots: [number, number][] = [];
const step = 2.6;
for (let lat = top; lat > bottom; lat -= step) {
  for (let lon = -180; lon < 180; lon += step) {
    const off = (Math.round((top - lat) / step) % 2) * (step / 2); // diagonal grid
    const L = lon + off;
    if (land.some((p) => inside(L, lat, p))) dots.push([px(L), py(lat)]);
  }
}

const home = { x: px(78.5), y: py(17.4) };
const stops = [
  { id: 'us', name: 'United States', place: 'Dallas · Irving, Texas', lon: -96.8, lat: 32.8, client: 'BaeMeds USA · Auvia', img: bmUs, dx: -1 },
  { id: 'uk', name: 'United Kingdom', place: 'London', lon: -0.1, lat: 51.5, client: 'MedusCore', img: med, dx: -1 },
  { id: 'gcc', name: 'GCC', place: 'Riyadh · Dubai', lon: 50.5, lat: 24.9, client: 'Talent Hunters · MedPulse', img: thc, dx: -1 },
  { id: 'in', name: 'India', place: 'Across India', lon: 77.2, lat: 28.6, client: 'Erus · The Qalb · BaeMeds India', img: erus, dx: 1 },
].map((s) => {
  const x = px(s.lon), y = py(s.lat);
  const mx = (x + home.x) / 2, my = Math.min(y, home.y) - Math.abs(x - home.x) * 0.32 - 18;
  return { ...s, x, y, d: `M${home.x},${home.y} Q${mx},${my} ${x},${y}` };
});
---

<section class="amap lab-dark" data-amap style={`--n:${stops.length}`}>
  <div class="amap-pin">
    <div class="amap-head">
      <p class="lab-mono amap-kicker">Where we work</p>
      <h2 class="lab-h amap-title">From Hyderabad,<br /><span class="lab-serif amap-em">to everywhere.</span></h2>
    </div>

    <ol class="amap-list" aria-label="Regions we work in">
      {stops.map((s, i) => (
        <li class="amap-li" data-li={i}>
          <span class="lab-mono amap-li-n">0{i + 1}</span>
          <span class="amap-li-name">{s.name}</span>
          <span class="lab-mono amap-li-client">{s.client}</span>
        </li>
      ))}
    </ol>

    <div class="amap-stage">
      <svg class="amap-svg" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
        <defs>
          <linearGradient id="amap-g" x1="0" x2="1" y1="0" y2="0">
            <stop offset="0" stop-color="#5b2a86" /><stop offset="0.4" stop-color="#f2464b" /><stop offset="1" stop-color="#ffb33f" />
          </linearGradient>
        </defs>
        <g class="amap-dots">
          {dots.map(([x, y]) => <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r="1.9" />)}
        </g>
        {stops.map((s, i) => (
          <g data-arc={i}>
            <path class="amap-arc" d={s.d} pathLength="1" />
            <circle class="amap-end" cx={s.x} cy={s.y} r="5" />
            <circle class="amap-ring" cx={s.x} cy={s.y} r="5" />
          </g>
        ))}
        <circle class="amap-home-ring" cx={home.x} cy={home.y} r="9" />
        <circle class="amap-home" cx={home.x} cy={home.y} r="6" />
        <text class="amap-home-label" x={home.x + 12} y={home.y + 22}>Hyderabad</text>
      </svg>
      {stops.map((s, i) => (
        <div class:list={['amap-card', s.dx === 1 && 'is-below']} data-card={i} style={`left:${(s.x / W) * 100}%;top:${(s.y / H) * 100}%`}>
          <Image src={s.img} alt="" width={360} class="amap-card-img" loading="eager" />
          <span class="amap-card-txt"><b>{s.place}</b><span class="lab-mono">{s.client}</span></span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .amap { position: relative; height: calc(var(--n) * 70vh + 100vh); }
  .amap-pin { position: sticky; top: 0; height: 100vh; overflow: hidden; display: grid; grid-template-columns: minmax(16rem, 1fr) 3fr; grid-template-rows: auto 1fr; gap: 1.5rem 3vw; padding: 7rem 4vw 3rem; }
  :global(html:not(.motion)) .amap { height: auto; }
  :global(html:not(.motion)) .amap-pin { position: relative; height: auto; }
  .amap-head { grid-column: 1 / -1; }
  .amap-kicker { margin: 0 0 0.8rem; color: rgba(251, 244, 234, 0.55); font-size: 0.75rem; }
  .amap-title { margin: 0; font-size: clamp(1.8rem, 3.6vw, 3.4rem); line-height: 1; color: #fbf4ea; }
  .amap-em { text-transform: none; font-size: 1.15em; background: var(--lab-grad); -webkit-background-clip: text; background-clip: text; color: transparent; }

  .amap-list { list-style: none; margin: 0; padding: 0; align-self: center; display: grid; gap: 0.2rem; }
  .amap-li { display: grid; grid-template-columns: 2.2rem 1fr; gap: 0.15rem 0.6rem; padding: 0.9rem 0; border-top: 1px solid rgba(251, 244, 234, 0.12); opacity: 0.35; transition: opacity 0.4s; }
  .amap-li.is-on { opacity: 1; }
  .amap-li-n { color: #ff7a2f; font-size: 0.75rem; padding-top: 0.25rem; }
  .amap-li-name { font: 600 1.15rem 'Inter Tight', sans-serif; color: #fbf4ea; }
  .amap-li-client { grid-column: 2; color: rgba(251, 244, 234, 0.55); font-size: 0.72rem; }

  .amap-stage { position: relative; align-self: center; width: 100%; aspect-ratio: 1000 / 420; }
  .amap-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .amap-dots circle { fill: rgba(251, 244, 234, 0.2); }
  .amap-arc { fill: none; stroke: url(#amap-g); stroke-width: 2.4; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: var(--d, 1); }
  .amap-end { fill: #ffb33f; opacity: var(--e, 0); }
  .amap-ring { fill: none; stroke: #ffb33f; stroke-width: 1.5; opacity: 0; transform-box: fill-box; transform-origin: center; }
  [data-arc].is-landed .amap-ring { animation: amap-ping 2s ease-out infinite; }
  .amap-home { fill: #ff7a2f; }
  .amap-home-ring { fill: none; stroke: #ff7a2f; stroke-width: 1.5; transform-box: fill-box; transform-origin: center; animation: amap-ping 2.4s ease-out infinite; }
  .amap-home-label { fill: #fbf4ea; font: 600 15px 'JetBrains Mono', monospace; letter-spacing: 0.04em; }
  @keyframes amap-ping { from { transform: scale(1); opacity: 0.9; } to { transform: scale(4); opacity: 0; } }

  .amap-card { position: absolute; z-index: 2; display: flex; align-items: center; gap: 0.6rem; width: max-content; max-width: 17rem; padding: 0.45rem 0.8rem 0.45rem 0.45rem; border-radius: 14px; background: #fbf4ea; color: #1a1218; box-shadow: 0 24px 40px -20px rgba(0, 0, 0, 0.7); transform: translate(-50%, calc(-100% - 16px)) scale(var(--s, 0)); transform-origin: bottom center; opacity: var(--s, 0); transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s; }
  .amap-card.is-below { transform: translate(-50%, 16px) scale(var(--s, 0)); transform-origin: top center; }
  .amap-card-img { width: 3.4rem; height: 2.6rem; border-radius: 8px; object-fit: cover; object-position: top; }
  .amap-card-txt { display: grid; gap: 0.1rem; font: 600 0.82rem 'Inter Tight', sans-serif; }
  .amap-card-txt .lab-mono { font-size: 0.62rem; color: #7b6a66; font-weight: 400; }
  :global(html:not(.motion)) .amap-card { --s: 1; }
  :global(html:not(.motion)) .amap-arc { --d: 0; }
  :global(html:not(.motion)) .amap-end { --e: 1; }
  :global(html:not(.motion)) .amap-li { opacity: 1; }

  @media (max-width: 900px) {
    .amap-pin { grid-template-columns: 1fr; grid-template-rows: auto auto auto; align-content: center; padding: 6rem 1.25rem 2rem; }
    .amap-stage { order: 2; width: 150%; margin-left: -18%; }
    .amap-list { order: 3; grid-template-columns: 1fr 1fr; gap: 0 1rem; }
    .amap-li { padding: 0.6rem 0; }
    .amap-li-name { font-size: 0.95rem; }
    .amap-card { max-width: 11rem; padding: 0.35rem 0.6rem 0.35rem 0.35rem; }
    .amap-card-img { width: 2.4rem; height: 1.8rem; }
    .amap-card-txt { font-size: 0.7rem; }
    .amap-card-txt .lab-mono { display: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const root = document.querySelector<HTMLElement>('[data-amap]');
  if (root && document.documentElement.classList.contains('motion')) {
    const arcs = [...root.querySelectorAll<SVGGElement>('[data-arc]')];
    const cards = [...root.querySelectorAll<HTMLElement>('[data-card]')];
    const lis = [...root.querySelectorAll<HTMLElement>('[data-li]')];
    const n = arcs.length;
    ScrollTrigger.create({
      trigger: root,
      start: 'top top',
      end: 'bottom bottom',
      onUpdate: (self) => {
        const head = self.progress * (n + 0.4);
        arcs.forEach((g, i) => {
          const t = Math.max(0, Math.min(1, (head - i) * 1.6));
          const landed = t >= 1;
          g.style.setProperty('--d', String(1 - t));
          g.style.setProperty('--e', landed ? '1' : '0');
          g.classList.toggle('is-landed', landed);
          cards[i].style.setProperty('--s', landed ? '1' : '0');
          lis[i].classList.toggle('is-on', t > 0);
        });
      },
    });
  }
</script>
